# Supabase (Fase 0/1) — desde Project Settings > API en el dashboard de Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Meta / Graph API (recién se usan a partir de la Fase 5)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# GoHighLevel (Fase 5B) — Private Integration Token generado en Configuración >
# Usuarios > Usuarios del sistema de la cuenta de GHL, con scopes emails/builder.readonly
# y emails/builder.write. GHL_LOCATION_ID es el id de la sub-cuenta ("location") en GHL.
GHL_API_KEY=
GHL_LOCATION_ID=
